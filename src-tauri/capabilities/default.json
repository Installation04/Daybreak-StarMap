{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The map window: core window permissions; opening the page's outbound links (wiki, papers, GitHub) in the default browser; closing the window after the unsaved-changes prompt; and reading and writing scenario files and CSV exports in the save folder, in folders and files picked in the system dialogs, and the recovery copy in the app's own data folder.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "http://**"
        }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-rename",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$DOCUMENT/Daybreak Star Map"
        },
        {
          "path": "$DOCUMENT/Daybreak Star Map/**"
        },
        {
          "path": "$APPLOCALDATA"
        },
        {
          "path": "$APPLOCALDATA/**"
        }
      ]
    }
  ]
}
